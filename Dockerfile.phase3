FROM crucible-sandbox:phase1

COPY config/phase3-locks /opt/crucible/config/phase3-locks

RUN set -eu; \
    for profile in jd--tenacity--phase3 marshmallow-code--marshmallow--phase3 pallets--flask--2021 pallets--flask--2022 pallets--flask--2023; do \
        python -m venv "/opt/phase3-venvs/$profile"; \
        "/opt/phase3-venvs/$profile/bin/pip" install --no-cache-dir -r "/opt/crucible/config/phase3-locks/$profile.txt"; \
    done
