+"""Tests for the is_fstring_start function in blib2to3 tokenizer."""
+
+from blib2to3.pgen2.tokenize import fstring_prefix, is_fstring_start
+
+
+def test_fstring_prefix_is_tuple() -> None:
+    """fstring_prefix must be a tuple so str.startswith() can accept it."""
+    assert isinstance(fstring_prefix, tuple)
+
+
+def test_is_fstring_start() -> None:
+    """Verify is_fstring_start correctly identifies f-string prefixes."""
+    # Should return True for valid f-string starts
+    assert is_fstring_start('f"')
+    assert is_fstring_start("f'")
+    assert is_fstring_start('F"')
+    assert is_fstring_start("F'")
+    assert is_fstring_start('fr"')
+    assert is_fstring_start("fr'")
+    assert is_fstring_start('Fr"')
+    assert is_fstring_start("fR'")
+    assert is_fstring_start('FR"')
+    assert is_fstring_start("FR'")
+    assert is_fstring_start('rf"')
+    assert is_fstring_start("rf'")
+    assert is_fstring_start('Rf"')
+    assert is_fstring_start("rF'")
+    assert is_fstring_start('RF"')
+    assert is_fstring_start("RF'")
+    assert is_fstring_start('f"""')
+    assert is_fstring_start("f'''")
+    assert is_fstring_start('F"""')
+    assert is_fstring_start("F'''")
+    assert is_fstring_start('fr"""')
+    assert is_fstring_start("fr'''")
+    assert is_fstring_start('FR"""')
+    assert is_fstring_start("FR'''")
+    assert is_fstring_start('rf"""')
+    assert is_fstring_start("rf'''")
+    assert is_fstring_start('RF"""')
+    assert is_fstring_start("RF'''")
+
+    # Should return False for non-f-string strings
+    assert not is_fstring_start('"')
+    assert not is_fstring_start("'")
+    assert not is_fstring_start('"""')
+    assert not is_fstring_start("'''")
+    assert not is_fstring_start('r"')
+    assert not is_fstring_start("r'")
+    assert not is_fstring_start('b"')
+    assert not is_fstring_start("b'")
+    assert not is_fstring_start('u"')
+    assert not is_fstring_start("u'")
+    assert not is_fstring_start('RB"')
+    assert not is_fstring_start("RB'")
+    assert not is_fstring_start("hello")
+    assert not is_fstring_start("")
