+import warnings
+
+import click
+
+
+def test_get_terminal_size_deprecated():
+    """``click.get_terminal_size()`` is deprecated in favor of
+    :func:`shutil.get_terminal_size`.
+    """
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        size = click.get_terminal_size()
+
+    # A deprecation warning should have been emitted.
+    assert len(w) == 1
+    assert issubclass(w[0].category, DeprecationWarning)
+    assert "deprecated" in str(w[0].message).lower()
+
+    # The return value should be a named tuple with a ``.columns``
+    # attribute, matching the stdlib ``shutil.get_terminal_size()``.
+    assert hasattr(size, "columns")
+    assert isinstance(size.columns, int)
