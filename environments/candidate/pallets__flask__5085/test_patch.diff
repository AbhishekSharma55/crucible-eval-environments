+import warnings
+
+import pytest
+
+
+class TestMarkupDeprecation:
+    """Test that ``flask.Markup`` and ``from flask import Markup`` still work
+    but emit a deprecation warning."""
+
+    def test_flask_markup_attribute(self):
+        import flask
+
+        with pytest.warns(DeprecationWarning, match="flask.Markup"):
+            m = flask.Markup("<strong>hello</strong>")
+
+        assert m == "<strong>hello</strong>"
+
+    def test_flask_import_markup(self):
+        with pytest.warns(DeprecationWarning, match="flask.Markup"):
+            from flask import Markup
+
+        m = Markup("<strong>hello</strong>")
+        assert m == "<strong>hello</strong>"
