+import pytest
+
+import flask
+from flask.globals import _request_ctx_stack
+
+
+def test_request_context_g_deprecated(app):
+    """Accessing ``RequestContext.g`` emits a deprecation warning."""
+    with app.test_request_context():
+        with pytest.warns(DeprecationWarning, match="Accessing 'g' on the request context"):
+            g = _request_ctx_stack.top.g
