+import pytest
+
+import click
+
+
+def test_option_help_none(runner):
+    """Passing help=None to @click.option should not cause a TypeError."""
+
+    @click.command()
+    @click.option("--name", help=None)
+    def cli(name):
+        click.echo(name)
+
+    result = runner.invoke(cli, ["--name", "test"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "test"
+
+
+def test_option_cls_none(runner):
+    """Passing cls=None to @click.option should use the default Option class."""
+
+    @click.command()
+    @click.option("--name", cls=None)
+    def cli(name):
+        click.echo(name)
+
+    result = runner.invoke(cli, ["--name", "test"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "test"
+
+
+def test_argument_cls_none(runner):
+    """Passing cls=None to @click.argument should use the default Argument class."""
+
+    @click.command()
+    @click.argument("name", cls=None)
+    def cli(name):
+        click.echo(name)
+
+    result = runner.invoke(cli, ["test"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "test"
+
+
+def test_group_cls_none(runner):
+    """Passing cls=None to @click.group should use the default Group class."""
+
+    @click.group(cls=None)
+    def cli():
+        pass
+
+    @cli.command()
+    def sub():
+        click.echo("sub")
+
+    result = runner.invoke(cli, ["sub"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "sub"
