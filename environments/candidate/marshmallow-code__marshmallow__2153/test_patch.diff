+"""Test that SchemaMeta.get_declared_fields passes dict_cls to overridden methods."""
+
+import pytest
+from marshmallow.schema import SchemaMeta, Schema
+
+
+class CustomMeta(SchemaMeta):
+    """Metaclass that overrides get_declared_fields with dict_cls as required param."""
+
+    @classmethod
+    def get_declared_fields(mcs, klass, cls_fields, inherited_fields, dict_cls):
+        return super().get_declared_fields(
+            klass=klass,
+            cls_fields=cls_fields,
+            inherited_fields=inherited_fields,
+            dict_cls=dict_cls,
+        )
+
+
+def test_get_declared_fields_passes_dict_cls():
+    """A metaclass overriding get_declared_fields with a required dict_cls
+    parameter should not raise TypeError when defining a Schema subclass."""
+
+    class MySchema(Schema, metaclass=CustomMeta):
+        pass
+
+    # The schema should be created successfully
+    assert hasattr(MySchema, "_declared_fields")
