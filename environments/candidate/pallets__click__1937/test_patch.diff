+"""Test that the completion example's list_users function returns
+a list, not a generator, so that shell completion works without
+raising TypeError: 'generator' object is not subscriptable.
+"""
+import sys
+
+import pytest
+
+
+# Import the example module
+sys.path.insert(0, "examples/completion")
+from completion import list_users
+
+
+class FakeContext:
+    pass
+
+
+class FakeParam:
+    pass
+
+
+def test_list_users_returns_list():
+    """list_users should return a list, not a generator, so that
+    shell completion can subscript the result.
+    """
+    result = list_users(FakeContext(), FakeParam(), "")
+    assert isinstance(result, list)
+    assert len(result) == 3
+    # Check that items are CompletionItem-like with value and help
+    values = [r.value for r in result]
+    assert "bob" in values
+    assert "alice" in values
+    assert "jerry" in values
