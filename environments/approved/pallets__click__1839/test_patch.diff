+from unittest.mock import patch
+
+import click
+
+
+def test_launch_file_url():
+    """Calling ``click.launch`` with a ``file://`` URL should not raise
+    ``AttributeError`` due to ``urllib.unquote`` not being available in
+    Python 3 (the function is in ``urllib.parse.unquote``).
+    """
+    with patch("subprocess.Popen") as mock_popen:
+        mock_popen.return_value.wait.return_value = 0
+        result = click.launch("file:///home/user/document.txt")
+        assert result == 0
