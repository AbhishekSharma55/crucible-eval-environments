+"""Test that fields are accessible as Schema attributes.
+
+Regression test for https://github.com/marshmallow-code/marshmallow/issues/1628
+and https://github.com/marshmallow-code/marshmallow/pull/1631.
+"""
+
+from marshmallow import Schema, fields
+
+
+def test_fields_accessible_as_schema_attributes():
+    """Fields defined on a Schema class should be accessible as class attributes."""
+
+    class MySchema(Schema):
+        name = fields.String()
+        age = fields.Integer()
+
+    assert isinstance(MySchema.name, fields.Field)
+    assert isinstance(MySchema.age, fields.Field)
