+import pytest
+
+import click
+
+
+def test_strikethrough_style():
+    """``click.style`` supports the ``strikethrough`` parameter."""
+    result = click.style("test", strikethrough=True)
+    assert "\033[9m" in result
+    assert "\033[29m" not in result
+
+    result = click.style("test", strikethrough=False)
+    assert "\033[29m" in result
+    assert "\033[9m" not in result
